{
  "manifest_version": 3,
  "name": "Indy — Root & Intermediate Certificate Trust Guard",
  "version": "1.0.0",
  "description": "Makes accepting root and intermediate TLS certificates visible and optional with Accept, Ask, and Deny policies booted from system root certificates.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:7879/*",
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Indy Certificate Trust Guard",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
